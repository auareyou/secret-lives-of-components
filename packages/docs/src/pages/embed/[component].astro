---
import EmbedLayout from "../../layouts/EmbedLayout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import { components, type ComponentEntry } from "../../data/components.ts";

export function getStaticPaths() {
  return components.map((entry) => ({
    params: { component: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: ComponentEntry;
}

const { entry } = Astro.props;
---

<EmbedLayout title={`${entry.title} preview`}>
  <ComponentPreview bare>
    {entry.tagName === "sl-button" && (
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <sl-button variant="primary">Primary</sl-button>
        <sl-button variant="secondary">Secondary</sl-button>
        <sl-button variant="danger">Danger</sl-button>
      </div>
    )}
  </ComponentPreview>
</EmbedLayout>
